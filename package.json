{
  "name": "pi-context-compaction",
  "version": "0.1.0",
  "description": "Context window policy and checkpoint continuation for Pi",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/datspike/context-compaction.git"
  },
  "license": "MIT",
  "type": "module",
  "files": [
    "index.ts",
    "audit.ts",
    "card.ts",
    "checkpoint.ts",
    "language.ts",
    "policy.ts",
    "compact-budget.ts",
    "session-state.ts",
    "summary.ts",
    "append-compaction.ts",
    "append-route.ts",
    "request-stage.ts",
    "request-stage/request-stage-controller.mjs",
    "request-stage/generation-meter.mjs",
    "request-stage/generation-telemetry.mjs",
    "request-stage/rate-overlay.mjs",
    "file-hints.ts",
    "README.md",
    "docs/workflows.md",
    "LICENSE",
    "package.json"
  ],
  "piRuntime": {
    "package": "@earendil-works/pi-coding-agent",
    "contract": "runtime-derived package closure and public extension APIs"
  },
  "scripts": {
    "test": "node scripts/with-pi-runtime.mjs test",
    "typecheck": "node scripts/with-pi-runtime.mjs typecheck",
    "test:stage": "node --test request-stage/*.test.mjs",
    "verify": "npm run typecheck && npm test && npm run test:stage"
  },
  "pi": {
    "extensions": [
      "./index.ts"
    ]
  },
  "peerDependencies": {
    "@earendil-works/pi-coding-agent": "*",
    "@earendil-works/pi-tui": "*"
  },
  "devDependencies": {
    "@earendil-works/pi-coding-agent": "^0.87.1",
    "@earendil-works/pi-tui": "^0.87.1",
    "typescript": "5.9.3"
  }
}
